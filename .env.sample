SN_INSTANCE=your_instance_name  # e.g., 'dev12345' if your URL is dev12345.service-now.com
SN_USERNAME=admin
SN_PASSWORD=your_secure_password

# Authentication: basic (default) or oauth
SN_AUTH_MODE=basic
# For OAuth, use either a pre-issued token or client credentials.
SN_OAUTH_ACCESS_TOKEN=
SN_OAUTH_CLIENT_ID=
SN_OAUTH_CLIENT_SECRET=
SN_OAUTH_REFRESH_TOKEN=
# Optional: client_credentials, password, or refresh_token. If omitted,
# refresh_token is selected when SN_OAUTH_REFRESH_TOKEN is set; otherwise password.
SN_OAUTH_GRANT_TYPE=
# Optional OAuth scope, for example: useraccount
SN_OAUTH_SCOPE=
# Defaults to https://<instance>.service-now.com/oauth_token.do
SN_OAUTH_TOKEN_URL=